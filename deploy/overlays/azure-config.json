{
  "serviceAccountName": "video-worker",
  "serviceAccountAnnotations": {
    "azure.workload.identity/client-id": "{{WORKLOAD_CLIENT_ID}}"
  },
  "podLabels": {
    "azure.workload.identity/use": "true"
  },
  "controlPlaneNodeSelector": {
    "kubernetes.io/os": "linux",
    "kubernetes.azure.com/mode": "system"
  },
  "controlPlaneTolerations": [],
  "mediaNodeSelectorSpot": {
    "workload": "video-encoding",
    "kubernetes.azure.com/scalesetpriority": "spot",
    "kubernetes.io/os": "linux"
  },
  "mediaNodeSelectorRegular": {
    "workload": "video-encoding",
    "kubernetes.azure.com/scalesetpriority": "regular",
    "kubernetes.io/os": "linux"
  },
  "mediaTolerationsSpot": [
    {
      "key": "kubernetes.azure.com/scalesetpriority",
      "operator": "Equal",
      "value": "spot",
      "effect": "NoSchedule"
    }
  ],
  "mediaTolerationsRegular": [],
  "storage": {
    "csiDriver": "blob.csi.azure.com",
    "inputVolumeAttributes": {
      "protocol": "fuse2",
      "storageAccount": "{{INPUT_STORAGE_ACCOUNT}}",
      "containerName": "{{INPUT_STORAGE_CONTAINER}}",
      "ClientID": "{{WORKLOAD_CLIENT_ID}}",
      "mountWithWorkloadIdentityToken": "true",
      "mountOptions": "--allow-other --use-attr-cache=true --file-cache-timeout-in-seconds=300 --cancel-list-on-mount-seconds=10"
    },
    "outputVolumeAttributes": {
      "protocol": "fuse2",
      "storageAccount": "{{OUTPUT_STORAGE_ACCOUNT}}",
      "containerName": "{{OUTPUT_STORAGE_CONTAINER}}",
      "ClientID": "{{WORKLOAD_CLIENT_ID}}",
      "mountWithWorkloadIdentityToken": "true",
      "mountOptions": "--allow-other --use-attr-cache=true --file-cache-timeout-in-seconds=30 --disable-writeback-cache=true"
    }
  },
  "scaler": {
    "storagequeue": {
      "mode": "keda",
      "type": "azure-queue",
      "metadata": {
        "accountName": "{{OUTPUT_STORAGE_ACCOUNT}}",
        "queueName": "video-submitted",
        "queueLength": "1",
        "activationQueueLength": "0"
      },
      "authenticationRef": "video-workload-identity",
      "triggerAuthentication": {
        "podIdentity": {
          "provider": "azure-workload",
          "identityId": "{{WORKLOAD_CLIENT_ID}}"
        }
      }
    },
    "servicebus": {
      "mode": "keda",
      "type": "azure-servicebus",
      "metadata": {
        "namespace": "{{SERVICE_BUS_NAMESPACE_SHORT}}",
        "queueName": "video-submitted",
        "messageCount": "1",
        "activationMessageCount": "0"
      },
      "authenticationRef": "video-workload-identity",
      "triggerAuthentication": {
        "podIdentity": {
          "provider": "azure-workload",
          "identityId": "{{WORKLOAD_CLIENT_ID}}"
        }
      }
    }
  }
}
